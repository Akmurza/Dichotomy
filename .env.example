NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required only for the one-time corpus ingestion script.
# Never expose this value in the browser or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional last-resort related-term suggestions for search.
# The model must never be used as a source of quotations.
GROQ_API_KEY=your-groq-api-key
